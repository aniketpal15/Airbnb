<% layout('/layouts/boilerplate') -%>
<div class="form-wrapper">
    <div class="container">
        <div class="head">NEW POST</div>
        <form action="/new" method="post">
            <div class="inp-title" >Title</div>
            <input name="title" type="title" placeholder="Title" class="describtion" required>
            <div class="inp-title">Description</div>
            <textarea name="description" rows="10" cols="50" class="description" style="resize:none;" required></textarea>
            <div class="inp-title">Img URL</div>
            <input name="img" type="url" placeholder="Img URL" class="Img URL">
            <div class="inp-title">Price</div>
            <input name="price" type="number" placeholder="&#8377;100" class="Price" required>
            <div class="inp-title">Location</div>
            <input name="location"  type="text" placeholder="Location" class="Location" required>
            <div class="inp-title">Country</div>
            <input name="country" type="text" placeholder="Country" class="Country" required>
            <button>submit</button>
        </form>
    </div>
</div>